{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"], "types": ["node"], "strict": true,
    "allowImportingTsExtensions": true, "noEmit": true, "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/atlas/**/*.ts", "tests/**/*.ts", "demos/atlas/**/*.ts", "vite.atlas.config.ts"]
}
